{
  "name": "agentdeck",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:xai-research-mcp": "node --test scripts/xai-research-mcp.node-test.mjs",
    "tauri": "tauri",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && cargo test --manifest-path src-tauri/Cargo.toml && bash scripts/preflight.sh",
    "hermes:guard": "cargo run --manifest-path src-tauri/Cargo.toml --bin hermes -- guard --dry-run \"pnpm verify\"",
    "hermes:overnight": "cargo run --manifest-path src-tauri/Cargo.toml --bin hermes -- overnight --queue tasks/overnight.queue.json",
    "hermes:overnight:dry-run": "AGENTDECK_COMPOSER_BRIDGE=dry-run pnpm hermes:overnight"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@xyflow/react": "^12.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.33.0"
}
