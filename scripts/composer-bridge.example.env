# Cursor Agent CLI bridge for Hermes → Composer 2.5
# Copy to composer-bridge.local.env and source before overnight runs (do not commit secrets).

# Bridge backend: cursor-agent (default) or dry-run
AGENTDECK_COMPOSER_BRIDGE=cursor-agent

# Cursor Agent CLI mode: plan (read-only, default) or agent (returns patches for overnight)
AGENTDECK_COMPOSER_CURSOR_MODE=agent

# Model slug for Cursor Agent CLI
AGENTDECK_COMPOSER_MODEL=composer-2.5-fast

# Headless auth (preferred for overnight). Alternative: `cursor agent login`
# CURSOR_API_KEY=

# Invocation timeout in seconds
AGENTDECK_COMPOSER_TIMEOUT_SECS=600