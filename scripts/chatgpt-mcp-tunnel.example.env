# Copy to scripts/chatgpt-mcp-tunnel.local.env and fill in values.
# Do not commit chatgpt-mcp-tunnel.local.env.

# From https://platform.openai.com/settings/organization/tunnels
export OPENAI_TUNNEL_ID="tunnel_..."

# API key with Tunnels Read + Use for the tunnel above
export OPENAI_API_KEY="sk-..."

# Local AgentDeck MCP HTTP endpoint (app must be running)
export AGENTDECK_MCP_URL="http://127.0.0.1:7823/mcp"

# Optional: path to OpenAI tunnel-client binary if not on PATH
# export TUNNEL_CLIENT_BIN="tunnel-client"