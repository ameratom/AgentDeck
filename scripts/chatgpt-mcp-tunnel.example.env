# Copy to:
# ~/Library/Application Support/com.agentdeck.desktop/chatgpt-mcp-tunnel.env
# Set its permissions to 600, fill in the values, and do not commit it.

# From https://platform.openai.com/settings/organization/tunnels
export OPENAI_TUNNEL_ID="tunnel_..."

# API key with Tunnels Read + Use for the tunnel above
export OPENAI_API_KEY="sk-..."

# Optional token shown by the OpenAI Apps dashboard for domain verification.
# Restart AgentDeck after changing it.
# export OPENAI_APPS_CHALLENGE_TOKEN="..."

# Upstream MCP endpoint the tunnel-client forwards to.
# Direct OpenAI tunnel (recommended): local AgentDeck HTTP.
export AGENTDECK_MCP_URL="http://127.0.0.1:7823/mcp"
# Public OAuth resource URL ChatGPT should see (HTTPS).
# Direct OpenAI tunnel:
# export MCP_PUBLIC_RESOURCE_URL="https://api.openai.com/v1/tunnel/tunnel_..."
# Cloudflared/public origin:
# export MCP_PUBLIC_RESOURCE_URL="https://mcp.example.com/mcp"

# Optional: path to OpenAI tunnel-client binary if not on PATH
# export TUNNEL_CLIENT_BIN="tunnel-client"
