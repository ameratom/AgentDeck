# Copy to notarize.local.env and fill in your values:
#   cp scripts/notarize.local.env.example scripts/notarize.local.env
#
# Load before building/notarizing:
#   source scripts/notarize.local.env
#
# notarize.local.env is gitignored — never commit secrets.

export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
export APPLE_ID="you@example.com"
export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
export APPLE_TEAM_ID="XXXXXXXXXX"